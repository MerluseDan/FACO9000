# Replace talk.example.com with a real DNS hostname pointing at this server.
# Caddy obtains and renews HTTPS certificates automatically when reachable.
talk.example.com {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8787
    header {
      Strict-Transport-Security "max-age=31536000"
      X-Content-Type-Options "nosniff"
      Referrer-Policy "no-referrer"
    }
}
